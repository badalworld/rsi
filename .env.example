# ---- Copy to .env and edit. Defaults already implement the trading rules. ----

# paper = simulated fills on real MEXC candles (safe default)
# live  = REAL orders on MEXC (also needs the keys below and LIVE_CONFIRM)
MODE=paper

# mexc = real MEXC public candles; synthetic = generated candles for demos/tests only
DATA_SOURCE=mexc

SYMBOLS=BTC_USDT,ETH_USDT,SOL_USDT
POLL_SECONDS=15

PORT=3000
HOST=0.0.0.0

# ---- Sizing & risk (rules) ----
PAPER_START_BALANCE=1000
RISK_MARGIN_PCT=8        # 8% of balance used as margin per trade
LEVERAGE=10              # 10x => position notional = 80% of balance
REWARD_RATIO=2           # take profit at 1:2 of the stop distance
MAX_OPEN_POSITIONS=3
MIN_STOP_PCT=0.1         # sanity bounds on stop distance (%)
MAX_STOP_PCT=8.5         # must stay inside the 10x liquidation zone
STOP_BUFFER_PCT=0        # 0 = stop exactly at the swing low/high
STALE_SIGNAL_SECONDS=300

# ---- Market regime gate (choppy / high-volatility rule) ----
CHOP_PERIOD=14
CHOP_MAX=61.8            # Choppiness Index above this = choppy zone, no trades
ATR_PERIOD=14
ATR_BASE_PERIOD=50
VOL_RATIO_MIN=1.0        # ATR(14) must be >= its 50-bar average

# ---- Mo3ty RSI indicator (defaults = the Pine script's inputs) ----
RSI_LENGTH=16
RSI_OVERBOUGHT=70
RSI_OVERSOLD=30
PIVOT_LEFT=5
PIVOT_RIGHT=5
DIV_ZONE_FILTER=true

# ---- Paper simulation ----
PAPER_SLIPPAGE_PCT=0.02

# ---- Live trading (only used when MODE=live) ----
MEXC_API_KEY=
MEXC_API_SECRET=
MEXC_POSITION_MODE=1     # 1 = hedge (exchange default), 2 = one-way
LIVE_CONFIRM=            # must be exactly I_UNDERSTAND_LIVE_TRADING to start live

# ---- Demo helper ----
SYNTHETIC_BACKFILL_BARS=0
